# Contact form email delivery (SMTP)
# Recipient for "Send message" (temporary test inbox)
CONTACT_TO_EMAIL=info.studiva@gmail.com

# Example for Gmail: create an App Password for the sending account
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sending-account@gmail.com
SMTP_PASS=your-app-password
# Optional From header (defaults to SMTP_USER)
# SMTP_FROM="Bay Area Chess <your-sending-account@gmail.com>"

# Local auth database (defaults to server/api/data/auth.sqlite)
# AUTH_DB_PATH=/absolute/path/to/auth.sqlite

# Public site URL used in password-reset emails and Google return
# CLIENT_URL=http://localhost:3000

# Google OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Must match Authorized redirect URI in Google Cloud Console exactly:
# GOOGLE_REDIRECT_URI=http://localhost:5001/api/login/google/callback
