# Contact form email delivery (SMTP)
# Recipient for "Send message" (temporary test inbox)
CONTACT_TO_EMAIL=info.studiva@gmail.com

# Example for Gmail: create an App Password for the sending account
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sending-account@gmail.com
SMTP_PASS=your-app-password
# Optional From header (defaults to SMTP_USER)
# SMTP_FROM="Bay Area Chess <your-sending-account@gmail.com>"
